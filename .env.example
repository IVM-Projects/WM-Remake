# Copier en .env.local et remplir. Ne jamais committer de vraie valeur.

# --- Supabase ---
# URL du projet (publique)
NEXT_PUBLIC_SUPABASE_URL=
# Clé publiable sb_publishable_… (publique)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé secrète sb_secret_… (service role) : serveur uniquement
SUPABASE_SECRET_KEY=
# Nom du cookie de session (option B), facultatif ; NEXT_PUBLIC_ car le client navigateur le lit aussi
NEXT_PUBLIC_AUTH_COOKIE_NAME=

# --- Services ---
# Cloudflare Turnstile. Clés de test Cloudflare, toujours valides : site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
# Clé de site (publique) ; vide : pas de widget, le client envoie le jeton dev-bypass
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Secret : serveur uniquement ; vide : toute vérification humaine est refusée
TURNSTILE_SECRET_KEY=
# Vérificateur, facultatif ; vide : https://challenges.cloudflare.com/turnstile/v0/siteverify
TURNSTILE_VERIFY_URL=
# Stripe (clés de test)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Web Push : paire générée hors du dépôt (npx web-push generate-vapid-keys), seule la clé privée est posée
# Ignorée : la clé publique est toujours dérivée de VAPID_PRIVATE (M4b-14)
VAPID_PUBLIC=
VAPID_PRIVATE=
# https: ou mailto: ; sans lui, ou mal formé, le push est coupé
VAPID_SUBJECT=
# Secret des tâches planifiées (aussi dans Supabase Vault)
CRON_SECRET=

# --- App ---
# Marque affichée ; vide = WikiCartes. La marque d'origine exige DEMO_GATE_PASSWORD (le build échoue sinon).
NEXT_PUBLIC_BRAND_NAME=
# Mot de passe de la porte démo
DEMO_GATE_PASSWORD=
# Secret de signature du cookie de porte
GATE_COOKIE_SECRET=
# Mode démo
DEMO_MODE=

# --- Pages légales ---
# Identité de l'éditeur (pages légales), jamais dans le dépôt (A11).
LEGAL_PUBLISHER=
LEGAL_ADDRESS=
LEGAL_DIRECTOR=
LEGAL_CONTACT=
LEGAL_HOST=
